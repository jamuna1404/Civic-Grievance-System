# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Database Connection (Direct Connection to Supabase Postgres with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
# For migrations using Alembic, you might need a sync connection or we can use asyncpg with Alembic.
# For local dev, you can use the docker-compose postgres DB.
